# Copy this file to ".env.local" and fill in your values.
# .env.local is git-ignored. NEVER commit real keys.

# Required. Key for the OpenAI-compatible endpoint (IONext). Server-only.
LLM_API_KEY=your-provider-api-key-here

# Optional. Chat-completions URL (default: IONext) and model id.
# LLM_ENDPOINT=https://inference.ionext.ai/v1/chat/completions
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B

# Optional. Upstash Redis for rate limits and per-student captures.
# Leave blank for local dev (falls back to in-memory).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional cost guards (defaults shown).
# LAB_RATE_PER_ID=8          # requests per minute per student id
# LAB_RATE_PER_IP=120        # requests per minute per IP address
# LAB_DAILY_TOKENS=3000000   # global token budget per day, then the lab pauses
